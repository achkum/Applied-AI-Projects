# Image references only, NEVER credentials. Resolve official registry digests before preflight.
# PostgreSQL16 Debian image must have verified postgres UID/GID999.
SANDBOX_POSTGRES_IMAGE=postgres:16-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
SANDBOX_CADDY_IMAGE=caddy:2.11.7@sha256:REPLACE_WITH_VERIFIED_DIGEST
SANDBOX_API_IMAGE=subtrack-sandbox-api@sha256:REPLACE_WITH_REVIEWED_DIGEST
# API Dockerfile build input: official Node22 Debian digest, verified separately.
SANDBOX_NODE_IMAGE=node:22-bookworm-slim@sha256:REPLACE_WITH_VERIFIED_DIGEST
