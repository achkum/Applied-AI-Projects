{
  "name": "subtrack-individual-experience",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.mjs",
    "dev:foundation": "tsx src/server.ts",
