generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY
//
// One row per application user. Owns authentication credentials and the
// unique personal identifier used to correlate BankID or OTP sessions.
//
// RLS scope: a user may read/write only their own identity row.
//   USING (id = current_setting('app.current_user_id')::uuid)
// ---------------------------------------------------------------------------
model Identity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable opaque identifier returned to clients; never the PII personal number.
  externalId String?  @unique @map("external_id") @db.VarChar(255)
  /// Authentication method used to create this identity.
  authMethod AuthMethod @map("auth_method")
  /// Optional email address for OTP or notification delivery (nullable for BankID-only users).
  email      String?  @unique @db.VarChar(320)
  /// Optional Swedish mobile number in E.164 format for SMS OTP.
  phone      String?  @unique @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft-delete: set when account is deactivated; row kept for audit trail.
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  householdMemberships  HouseholdMember[]
  sentInvitations       Invitation[]        @relation("inviter")
  receivedInvitations   Invitation[]        @relation("invitee")
  consents              Consent[]
  auditEntries          AuditLog[]
  subscriptions         Subscription[]
  sharedSubscriptions   SubscriptionShare[] @relation("sharer")
  sessions              Session[]

  @@map("identity")
}

enum AuthMethod {
  BANKID
  OTP
  MOCK /// Only valid in development/simulator mode; rejected in production.

  @@map("auth_method")
}

// ---------------------------------------------------------------------------
// SESSION
//
// Opaque refresh-token sessions as created by the accepted 0003_session
// migration. RLS policies and database constraints are defined in that SQL.
// ---------------------------------------------------------------------------
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId       String    @map("identity_id") @db.Uuid
  deviceName       String    @map("device_name") @db.VarChar(120)
  refreshTokenHash String    @unique(map: "session_refresh_token_hash_key") @map("refresh_token_hash") @db.VarChar(64)
  familyId         String    @map("family_id") @db.Uuid
  generation       Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "session_identity_fkey")

  @@index([identityId], map: "session_identity_id_idx")
  @@map("session")
}

// ---------------------------------------------------------------------------
// HOUSEHOLD
//
// A billing group of 1–6 members sharing a subscription overview.
// The creator becomes the first admin. Deleting a household is not supported;
// instead it is soft-deleted when the last admin leaves.
//
// RLS scope: visible to all members of the household.
//   USING (id IN (
//     SELECT household_id FROM household_member
//     WHERE identity_id = current_setting('app.current_user_id')::uuid
//   ))
// ---------------------------------------------------------------------------
model Household {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Display name chosen by the creator; shown in the scope switcher.
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  members            HouseholdMember[]
  invitations        Invitation[]
  auditEntries       AuditLog[]
  subscriptionShares SubscriptionShare[]

  @@map("household")
}

// ---------------------------------------------------------------------------
// HOUSEHOLD MEMBER  (junction between identity and household)
//
// Tracks membership role, join date, and the open-book switch per member.
// A member belongs to at most one household at a time (enforced by unique
// constraint on identity_id where left_at IS NULL).
//
// RLS scope: a member may read rows for their own household;
//   only admins may update other members' roles.
//   USING (household_id IN (
//     SELECT household_id FROM household_member
//     WHERE identity_id = current_setting('app.current_user_id')::uuid
//   ))
// ---------------------------------------------------------------------------
model HouseholdMember {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String      @map("household_id") @db.Uuid
  identityId  String      @map("identity_id") @db.Uuid
  role        MemberRole  @default(MEMBER)
  joinedAt    DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// Set when a member leaves; kept for audit trail.
  leftAt      DateTime?   @map("left_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id])
  identity  Identity  @relation(fields: [identityId], references: [id])

  /// At most one active membership per user (leftAt IS NULL = active).
  /// Enforced by partial unique index in migration SQL.
  @@unique([householdId, identityId])
  @@map("household_member")
}

enum MemberRole {
  ADMIN
  MEMBER
  /// Dependant: added by admin without a login Identity. No account credentials.
  DEPENDANT

  @@map("member_role")
}

// ---------------------------------------------------------------------------
// INVITATION
//
// An invitation sent by a household admin to a potential member.
// Expires after 7 days; revocable by the inviter or any admin.
//
// Channels:
//   LINK/CODE — token is the credential; no specific recipient (recipient null).
//   EMAIL/SMS  — token delivered to recipient email/phone via dev adapter.
//
// Token storage: raw 32-byte random hex is given to the invitee; only the
// SHA-256 hex hash is stored (tokenHash), preventing lookup abuse.
//
// RLS scope:
//   - inviter: may read/revoke their own outgoing invitations.
//   - invitee: may read invitations addressed to them.
//   - admins: may read all invitations for their household.
//   USING (
//     inviter_id  = current_setting('app.current_user_id')::uuid
//     OR invitee_id = current_setting('app.current_user_id')::uuid
//     OR household_id IN (
//       SELECT household_id FROM household_member
//       WHERE identity_id = current_setting('app.current_user_id')::uuid
//         AND role = 'ADMIN'
//     )
//   )
// ---------------------------------------------------------------------------
model Invitation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String            @map("household_id") @db.Uuid
  inviterId   String            @map("inviter_id") @db.Uuid
  /// Set when invitee has accepted and linked their identity.
  inviteeId   String?           @map("invitee_id") @db.Uuid
  channel     InvitationChannel
  /// Email or phone the invitation was sent to; null for LINK/CODE channels.
  recipient   String?           @db.VarChar(320)
  /// SHA-256 hex of the 32-byte opaque invite token. Never the raw token.
  tokenHash   String?           @unique @map("token_hash") @db.VarChar(64)
  status      InvitationStatus  @default(PENDING)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id])
  inviter   Identity  @relation("inviter", fields: [inviterId], references: [id])
  invitee   Identity? @relation("invitee", fields: [inviteeId], references: [id])

  @@map("invitation")
}

enum InvitationChannel {
  LINK
  CODE
  EMAIL
  SMS

  @@map("invitation_channel")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

// ---------------------------------------------------------------------------
// CONSENT
//
// Per-user, per-scope privacy preference record.
// Records the open-book switch (A1) and always-private overrides (A3).
// Consent rows are never shared with other users — not even household members.
//
// RLS scope: identity may read/write only their own consent rows.
//   USING (identity_id = current_setting('app.current_user_id')::uuid)
// ---------------------------------------------------------------------------
model Consent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  /// The entity this consent applies to (household_id for open-book scope).
  scopeId    String   @map("scope_id") @db.Uuid
  scopeType  ConsentScopeType @map("scope_type")
  /// OPEN_BOOK: whether this member's subscriptions are visible to household peers.
  openBook   Boolean  @default(false) @map("open_book")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id])

  /// One consent record per identity × scope.
  @@unique([identityId, scopeId, scopeType])
  @@map("consent")
}

enum ConsentScopeType {
  HOUSEHOLD

  @@map("consent_scope_type")
}

// ---------------------------------------------------------------------------
// OTP_CHALLENGE
//
// Single-use challenge created for each OTP send request.
// Stores a salted hash of the code — never plaintext.
// Rate-limit state (send_count, last_sent_at) lives here to avoid a
// separate counters table while keeping all challenge state co-located.
//
// No FK to Identity: challenges are created before an identity may exist
// (i.e. during the registration flow). The identifier is matched to an
// identity only after successful verification.
//
// Not RLS-protected: challenges are looked up by the OTP service using a
// service role connection, never exposed directly to a user-context query.
// ---------------------------------------------------------------------------
model OtpChallenge {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Email or E.164 phone number the OTP was sent to. Never stored as PII in log events.
  identifier   String    @db.VarChar(320)
  /// hex-encoded SHA-256(code || salt). OTP plaintext is never persisted.
  codeHash     String    @map("code_hash") @db.Char(64)
  /// hex-encoded 16-byte random salt — separate from codeHash to allow safe comparison.
  salt         String    @db.Char(32)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Total sends so far (1 = initial, 2 = first resend, …). Capped at 6 before reject.
  sendCount    Int       @default(1) @map("send_count")
  lastSentAt   DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  /// Wrong-attempt counter. Locked when >= 5.
  attemptCount Int       @default(0) @map("attempt_count")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([createdAt])
  @@map("otp_challenge")
}

// ---------------------------------------------------------------------------
// AUDIT_LOG
//
// Append-only audit trail for security-sensitive mutations.
// Rows are never updated or deleted. All schema changes that affect identity,
// membership, or consent must write a corresponding audit entry.
//
// RLS scope:
//   - INSERT: any authenticated user may append their own entries.
//   - SELECT: only household admins may read entries for their household.
//   - UPDATE/DELETE: denied to all (enforced in migration SQL).
//   USING (
//     actor_id = current_setting('app.current_user_id')::uuid
//     OR (
//       household_id IS NOT NULL
//       AND household_id IN (
//         SELECT household_id FROM household_member
//         WHERE identity_id = current_setting('app.current_user_id')::uuid
//           AND role = 'ADMIN'
//       )
//     )
//   )
// ---------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The user who performed the action.
  actorId     String   @map("actor_id") @db.Uuid
  /// Household affected by this event, if applicable.
  householdId String?  @map("household_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  /// JSON payload of before/after state; never contains PII credentials.
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor     Identity   @relation(fields: [actorId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([actorId])
  @@index([householdId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTION
//
// One row per tracked recurring payment. Owned by the identity that pays.
// always_private overrides the household open_book switch for this specific
// subscription (ASSUMPTIONS.md A3).
//
// RLS scope (SELECT):
//   owner OR active explicit share in member's household OR
//   (owner has open_book consent in shared household AND NOT always_private)
//
// Full USING clause is in migration 0002 and mirrored by
// packages/domain/policy/subscription-visibility.ts.
// ---------------------------------------------------------------------------
model Subscription {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId          String              @map("identity_id") @db.Uuid
  merchantId          String?             @map("merchant_id") @db.Uuid
  customName          String?             @map("custom_name") @db.VarChar(120)
  /// Category code from the SubTrack taxonomy (CATEGORIES.md).
  categoryCode        String              @map("category_code") @db.VarChar(50)
  cadence             SubscriptionCadence
  /// Expected charge amount in the smallest currency unit (e.g. öre for SEK).
  expectedAmountMinor BigInt              @map("expected_amount_minor")
  currency            String              @db.Char(3)
  status              SubscriptionStatus  @default(DETECTED)
  /// Per-subscription privacy override: blocks Rule 3 (open_book) regardless of household consent.
  alwaysPrivate       Boolean             @default(false) @map("always_private")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  identity Identity           @relation(fields: [identityId], references: [id])
  shares   SubscriptionShare[]

  @@index([identityId])
  @@map("subscription")
}

enum SubscriptionCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM

  @@map("subscription_cadence")
}

enum SubscriptionStatus {
  DETECTED
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  ARCHIVED
  REJECTED

  @@map("subscription_status")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTION_SHARE
//
// Explicit share of a subscription into a household (Rule 2 of the visibility
// model). revokedAt IS NULL means the share is active.
//
// RLS scope (SELECT): sharer, OR household members, OR subscription owner.
// INSERT: subscription owner or household admin only.
// UPDATE: sharer may update (for revocation).
// ---------------------------------------------------------------------------
model SubscriptionShare {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  householdId    String    @map("household_id") @db.Uuid
  sharedBy       String    @map("shared_by") @db.Uuid
  sharedAt       DateTime  @default(now()) @map("shared_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  household    Household    @relation(fields: [householdId], references: [id])
  sharer       Identity     @relation("sharer", fields: [sharedBy], references: [id])

  @@index([subscriptionId])
  @@index([householdId])
  @@map("subscription_share")
}
