generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY
//
// One row per application user. Owns authentication credentials and the
// unique personal identifier used to correlate BankID or OTP sessions.
//
// RLS scope: a user may read/write only their own identity row.
//   USING (id = current_setting('app.current_user_id')::uuid)
// ---------------------------------------------------------------------------
model Identity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable opaque identifier returned to clients; never the PII personal number.
  externalId String?  @unique @map("external_id") @db.VarChar(255)
  /// Authentication method used to create this identity.
  authMethod AuthMethod @map("auth_method")
  /// Optional email address for OTP or notification delivery (nullable for BankID-only users).
  email      String?  @unique @db.VarChar(320)
  /// Optional Swedish mobile number in E.164 format for SMS OTP.
  phone      String?  @unique @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft-delete: set when account is deactivated; row kept for audit trail.
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  householdMemberships HouseholdMember[]
  sentInvitations      Invitation[]      @relation("inviter")
  receivedInvitations  Invitation[]      @relation("invitee")
  consents             Consent[]
  auditEntries         AuditLog[]
  bankConnections      BankConnection[]
  subscriptions        Subscription[]

  @@map("identity")
}

enum AuthMethod {
  BANKID
  OTP
  MOCK /// Only valid in development/simulator mode; rejected in production.

  @@map("auth_method")
}

// ---------------------------------------------------------------------------
// HOUSEHOLD
//
// A billing group of 1–6 members sharing a subscription overview.
// The creator becomes the first admin. Deleting a household is not supported;
// instead it is soft-deleted when the last admin leaves.
//
// RLS scope: visible to all members of the household.
//   USING (id IN (
//     SELECT household_id FROM household_member
//     WHERE identity_id = current_setting('app.current_user_id')::uuid
//   ))
// ---------------------------------------------------------------------------
model Household {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Display name chosen by the creator; shown in the scope switcher.
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  members     HouseholdMember[]
  invitations Invitation[]
  auditEntries AuditLog[]

  @@map("household")
}

// ---------------------------------------------------------------------------
// HOUSEHOLD MEMBER  (junction between identity and household)
//
// Tracks membership role, join date, and the open-book switch per member.
// A member belongs to at most one household at a time (enforced by unique
// constraint on identity_id where left_at IS NULL).
//
// RLS scope: a member may read rows for their own household;
//   only admins may update other members' roles.
//   USING (household_id IN (
//     SELECT household_id FROM household_member
//     WHERE identity_id = current_setting('app.current_user_id')::uuid
//   ))
// ---------------------------------------------------------------------------
model HouseholdMember {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String      @map("household_id") @db.Uuid
  identityId  String      @map("identity_id") @db.Uuid
  role        MemberRole  @default(MEMBER)
  joinedAt    DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// Set when a member leaves; kept for audit trail.
  leftAt      DateTime?   @map("left_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id])
  identity  Identity  @relation(fields: [identityId], references: [id])

  /// At most one active membership per user (leftAt IS NULL = active).
  /// Enforced by partial unique index in migration SQL.
  @@unique([householdId, identityId])
  @@map("household_member")
}

enum MemberRole {
  ADMIN
  MEMBER

  @@map("member_role")
}

// ---------------------------------------------------------------------------
// INVITATION
//
// An invitation sent by a household admin to a potential member.
// Expires after 48 hours; revocable by the inviter or any admin.
//
// RLS scope:
//   - inviter: may read/delete their own outgoing invitations.
//   - invitee: may read invitations addressed to them (by email/phone).
//   - admins: may read all invitations for their household.
//   USING (
//     inviter_id  = current_setting('app.current_user_id')::uuid
//     OR invitee_id = current_setting('app.current_user_id')::uuid
//     OR household_id IN (
//       SELECT household_id FROM household_member
//       WHERE identity_id = current_setting('app.current_user_id')::uuid
//         AND role = 'ADMIN'
//     )
//   )
// ---------------------------------------------------------------------------
model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId String           @map("household_id") @db.Uuid
  inviterId   String           @map("inviter_id") @db.Uuid
  /// May be null if invitee has not yet created an identity.
  inviteeId   String?          @map("invitee_id") @db.Uuid
  /// Delivery channel; exactly one of email or phone must be set.
  channel     InvitationChannel
  /// Email or phone the invitation was sent to.
  recipient   String           @db.VarChar(320)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id])
  inviter   Identity  @relation("inviter", fields: [inviterId], references: [id])
  invitee   Identity? @relation("invitee", fields: [inviteeId], references: [id])

  @@map("invitation")
}

enum InvitationChannel {
  EMAIL
  SMS

  @@map("invitation_channel")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

// ---------------------------------------------------------------------------
// CONSENT
//
// Per-user, per-scope privacy preference record.
// Records the open-book switch (A1) and always-private overrides (A3).
// Consent rows are never shared with other users — not even household members.
//
// RLS scope: identity may read/write only their own consent rows.
//   USING (identity_id = current_setting('app.current_user_id')::uuid)
// ---------------------------------------------------------------------------
model Consent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  /// The entity this consent applies to (household_id for open-book scope).
  scopeId    String   @map("scope_id") @db.Uuid
  scopeType  ConsentScopeType @map("scope_type")
  /// OPEN_BOOK: whether this member's subscriptions are visible to household peers.
  openBook   Boolean  @default(false) @map("open_book")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identity Identity @relation(fields: [identityId], references: [id])

  /// One consent record per identity × scope.
  @@unique([identityId, scopeId, scopeType])
  @@map("consent")
}

enum ConsentScopeType {
  HOUSEHOLD

  @@map("consent_scope_type")
}

// ---------------------------------------------------------------------------
// OTP_CHALLENGE
//
// Single-use challenge created for each OTP send request.
// Stores a salted hash of the code — never plaintext.
// Rate-limit state (send_count, last_sent_at) lives here to avoid a
// separate counters table while keeping all challenge state co-located.
//
// No FK to Identity: challenges are created before an identity may exist
// (i.e. during the registration flow). The identifier is matched to an
// identity only after successful verification.
//
// Not RLS-protected: challenges are looked up by the OTP service using a
// service role connection, never exposed directly to a user-context query.
// ---------------------------------------------------------------------------
model OtpChallenge {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Email or E.164 phone number the OTP was sent to. Never stored as PII in log events.
  identifier   String    @db.VarChar(320)
  /// hex-encoded SHA-256(code || salt). OTP plaintext is never persisted.
  codeHash     String    @map("code_hash") @db.Char(64)
  /// hex-encoded 16-byte random salt — separate from codeHash to allow safe comparison.
  salt         String    @db.Char(32)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Total sends so far (1 = initial, 2 = first resend, …). Capped at 6 before reject.
  sendCount    Int       @default(1) @map("send_count")
  lastSentAt   DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  /// Wrong-attempt counter. Locked when >= 5.
  attemptCount Int       @default(0) @map("attempt_count")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([createdAt])
  @@map("otp_challenge")
}

// ---------------------------------------------------------------------------
// AUDIT_LOG
//
// Append-only audit trail for security-sensitive mutations.
// Rows are never updated or deleted. All schema changes that affect identity,
// membership, or consent must write a corresponding audit entry.
//
// RLS scope:
//   - INSERT: any authenticated user may append their own entries.
//   - SELECT: only household admins may read entries for their household.
//   - UPDATE/DELETE: denied to all (enforced in migration SQL).
//   USING (
//     actor_id = current_setting('app.current_user_id')::uuid
//     OR (
//       household_id IS NOT NULL
//       AND household_id IN (
//         SELECT household_id FROM household_member
//         WHERE identity_id = current_setting('app.current_user_id')::uuid
//           AND role = 'ADMIN'
//       )
//     )
//   )
// ---------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The user who performed the action.
  actorId     String   @map("actor_id") @db.Uuid
  /// Household affected by this event, if applicable.
  householdId String?  @map("household_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  /// JSON payload of before/after state; never contains PII credentials.
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor     Identity   @relation(fields: [actorId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])

  @@index([actorId])
  @@index([householdId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// BANK CONNECTION
//
// A user's connection to a bank via Tink, the synthetic provider, or a
// test mock. One user may have multiple connections (different banks).
//
// RLS scope: ALWAYS PRIVATE — only the owning identity may read/write.
//   USING (identity_id = current_setting('app.current_user_id')::uuid)
// ---------------------------------------------------------------------------
model BankConnection {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId   String               @map("identity_id") @db.Uuid
  /// Data provider backing this connection.
  provider     BankProvider
  /// Provider-assigned connection identifier (e.g. Tink consentId).
  providerId   String               @map("provider_id") @db.VarChar(255)
  status       BankConnectionStatus @default(ACTIVE)
  lastSyncedAt DateTime?            @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Set when connection is disconnected; kept for audit trail.
  revokedAt    DateTime?            @map("revoked_at") @db.Timestamptz(6)

  identity Identity      @relation(fields: [identityId], references: [id])
  accounts BankAccount[]

  @@unique([identityId, providerId])
  @@map("bank_connection")
}

enum BankProvider {
  TINK
  SYNTHETIC
  MOCK

  @@map("bank_provider")
}

enum BankConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@map("bank_connection_status")
}

// ---------------------------------------------------------------------------
// BANK ACCOUNT
//
// A bank account (checking, savings, credit) associated with a connection.
// Full account numbers are stored encrypted at the application layer before
// being written here; raw account numbers MUST NOT appear in plaintext.
//
// RLS scope: ALWAYS PRIVATE.
//   USING (identity_id = current_setting('app.current_user_id')::uuid)
// ---------------------------------------------------------------------------
model BankAccount {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId      String      @map("connection_id") @db.Uuid
  identityId        String      @map("identity_id") @db.Uuid
  /// Provider-assigned account identifier.
  providerAccountId String      @map("provider_account_id") @db.VarChar(255)
  accountType       AccountType @map("account_type")
  /// Display name from the bank (e.g. "Privatkonto").
  displayName       String      @map("display_name") @db.VarChar(120)
  currency          String      @db.VarChar(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  connection   BankConnection   @relation(fields: [connectionId], references: [id])
  transactions RawTransaction[]

  @@unique([connectionId, providerAccountId])
  @@map("bank_account")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
  OTHER

  @@map("account_type")
}

// ---------------------------------------------------------------------------
// RAW TRANSACTION
//
// A verbatim transaction record fetched from the bank.
// This table holds PSD2 / Tink transaction payloads; never shared.
//
// RLS scope: ALWAYS PRIVATE.
//   USING (
//     account_id IN (
//       SELECT id FROM bank_account
//       WHERE identity_id = current_setting('app.current_user_id')::uuid
//     )
//   )
// ---------------------------------------------------------------------------
model RawTransaction {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String          @map("account_id") @db.Uuid
  /// Provider-assigned transaction identifier; used for deduplication.
  providerTransactionId String          @unique @map("provider_transaction_id") @db.VarChar(255)
  /// Signed minor-unit amount (negative = debit, positive = credit).
  amountMinor           BigInt          @map("amount_minor")
  currency              String          @db.VarChar(3)
  /// Date the transaction was booked (settled).
  bookedAt              DateTime        @map("booked_at") @db.Timestamptz(6)
  /// Date the value was effective (may differ from bookedAt for pending).
  valueDate             DateTime?       @map("value_date") @db.Date
  /// Raw descriptor from the bank statement.
  description           String          @db.VarChar(500)
  status                TransactionStatus @default(BOOKED)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  account BankAccount          @relation(fields: [accountId], references: [id])
  charges SubscriptionCharge[]

  @@index([accountId, bookedAt])
  @@map("raw_transaction")
}

enum TransactionStatus {
  PENDING
  BOOKED

  @@map("transaction_status")
}

// ---------------------------------------------------------------------------
// MERCHANT
//
// Normalised merchant/publisher database.
// Public read — contains no personal data.
// Written only by the data-pipeline and seeding jobs.
//
// RLS scope: SELECT open to all authenticated users; INSERT/UPDATE/DELETE
//   restricted to service role.
// ---------------------------------------------------------------------------
model Merchant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Canonical display name (e.g. "Netflix").
  canonicalName String   @unique @map("canonical_name") @db.VarChar(120)
  /// JSON array of known descriptor aliases (e.g. ["NETFLIX*", "NETFLIX.COM"]).
  aliases       Json     @default("[]")
  website       String?  @db.VarChar(255)
  /// OKLCH hue value (0–360) used to derive the category token for this merchant.
  categoryHue   Float?   @map("category_hue")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plans         CataloguePlan[]
  subscriptions Subscription[]

  @@map("merchant")
}

// ---------------------------------------------------------------------------
// CATALOGUE PLAN
//
// A specific subscription plan/tier offered by a merchant.
// Public read — no personal data.
//
// RLS scope: SELECT open to all; write restricted to service role.
// ---------------------------------------------------------------------------
model CataloguePlan {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String          @map("merchant_id") @db.Uuid
  /// Plan label (e.g. "Standard with ads", "Premium").
  name        String          @db.VarChar(120)
  period      BillingPeriod
  /// Illustrative list price in minor units (öre / cents).
  amountMinor BigInt?         @map("amount_minor")
  currency    String          @db.VarChar(3)
  /// ISO 3166-1 alpha-2 region or "GLOBAL".
  region      String          @default("GLOBAL") @db.VarChar(10)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  subscriptions Subscription[]

  @@map("catalogue_plan")
}

enum BillingPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  IRREGULAR

  @@map("billing_period")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTION
//
// A detected or manually-added recurring payment belonging to one identity.
//
// RLS scope: follows the visibility policy (ST-048).
//   USING (
//     identity_id = current_setting('app.current_user_id')::uuid
//     OR (
//       always_private = false
//       AND identity_id IN (
//         SELECT om.identity_id FROM household_member om
//         INNER JOIN household_member vm ON om.household_id = vm.household_id
//         INNER JOIN consent c
//           ON c.identity_id = om.identity_id
//          AND c.scope_id = om.household_id AND c.open_book = true
//         WHERE vm.identity_id = current_setting('app.current_user_id')::uuid
//           AND om.left_at IS NULL AND vm.left_at IS NULL
//       )
//     )
//   )
// ---------------------------------------------------------------------------
model Subscription {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId      String             @map("identity_id") @db.Uuid
  merchantId      String?            @map("merchant_id") @db.Uuid
  /// Optional matched catalogue plan.
  planId          String?            @map("plan_id") @db.Uuid
  /// User-facing display name (falls back to merchant.canonicalName).
  displayName     String             @map("display_name") @db.VarChar(120)
  /// Detected or confirmed recurring amount in minor units.
  amountMinor     BigInt             @map("amount_minor")
  currency        String             @db.VarChar(3)
  period          BillingPeriod
  /// Next predicted charge date.
  nextChargeAt    DateTime?          @map("next_charge_at") @db.Date
  /// Date the first transaction matching this subscription was seen.
  firstSeenAt     DateTime           @map("first_seen_at") @db.Timestamptz(6)
  /// Date of the most recent confirmed charge.
  lastConfirmedAt DateTime?          @map("last_confirmed_at") @db.Timestamptz(6)
  /// Per ASSUMPTIONS.md A3: overrides household open-book for this subscription.
  alwaysPrivate   Boolean            @default(false) @map("always_private")
  status          SubscriptionStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  identity Identity        @relation(fields: [identityId], references: [id])
  merchant Merchant?       @relation(fields: [merchantId], references: [id])
  plan     CataloguePlan?  @relation(fields: [planId], references: [id])
  charges  SubscriptionCharge[]

  @@index([identityId])
  @@index([merchantId])
  @@map("subscription")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED

  @@map("subscription_status")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTION CHARGE
//
// An individual charge event linked to a subscription.
// May or may not have a corresponding raw transaction (manual entries lack one).
//
// RLS scope: inherits from subscription — same USING clause.
// ---------------------------------------------------------------------------
model SubscriptionCharge {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  /// Source raw transaction, if detected automatically.
  rawTransactionId String? @map("raw_transaction_id") @db.Uuid
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @db.VarChar(3)
  chargedAt      DateTime @map("charged_at") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription    Subscription    @relation(fields: [subscriptionId], references: [id])
  rawTransaction  RawTransaction? @relation(fields: [rawTransactionId], references: [id])

  @@index([subscriptionId, chargedAt])
  @@map("subscription_charge")
}
