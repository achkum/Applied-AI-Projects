{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "API_BASE_URL": "https://staging.subtrack.local"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "API_BASE_URL": "https://api.subtrack.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6739906341"
      },
      "android": {
        "googlePlayJsonPath": "/opt/subtrack/secrets/play-console-key.json"
      }
    }
  }
}
