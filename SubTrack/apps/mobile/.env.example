# Non-secret Expo build variables; explicit native development opt-in only.
# Copy to ignored .env.local and configure only after private HTTPS trust/device
# routing is verified. No enabled default and no production API fallback.
EXPO_PUBLIC_MOBILE_ENROLLMENT_ENABLED=false
EXPO_PUBLIC_MOBILE_ENROLLMENT_HTTPS_URL=
# Example local verified development origin: https://localhost:3443
# API_BASE_URL is not automatically available in the native JavaScript bundle.
