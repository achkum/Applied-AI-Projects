{
  "expo": {
    "name": "SubTrack",
    "slug": "subtrack",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1214"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "se.subtrack.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1214"
      },
      "package": "se.subtrack.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./assets/fonts/Geist-Regular.ttf",
              "./assets/fonts/Geist-Medium.ttf",
              "./assets/fonts/Geist-SemiBold.ttf",
              "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
              "./assets/fonts/BricolageGrotesque-Bold.ttf",
              "./assets/fonts/BricolageGrotesque-ExtraBold.ttf"
            ]
          }
        }
      ],
      "./plugins/private-runtime-ca.cjs"
    ],
    "scheme": "subtrack",
    "newArchEnabled": false
  }
}
