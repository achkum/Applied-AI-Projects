{
  "color": {
    "light": {
      "bg.canvas": "#F7F4EE",
      "bg.raised": "#FFFFFF",
      "bg.sunken": "#EFEAE1",
      "ink.primary": "#15161C",
      "ink.secondary": "#5B5E6B",
      "aurora.green": "#0E9F6E",
      "aurora.violet": "#6A58F0",
      "aurora.teal": "#0B8FB0",
      "ember.amber": "#C77700",
      "ember.coral": "#D83A3A",
      "line.hairline": "rgba(21,22,28,0.08)"
    },
    "dark": {
      "bg.canvas": "#0A0C14",
      "bg.raised": "#12162A",
      "bg.sunken": "#070810",
      "ink.primary": "#F2EFE8",
      "ink.secondary": "#A5A9BE",
      "aurora.green": "#3DE0A3",
      "aurora.violet": "#9B8CFF",
      "aurora.teal": "#35C7E6",
      "ember.amber": "#FFB547",
      "ember.coral": "#FF6B6B",
      "line.hairline": "rgba(255,255,255,0.08)"
    }
  },
  "gradient": {
    "aurora": {
      "angleDegrees": 120,
      "stops": ["aurora.violet", "aurora.teal", "aurora.green"]
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Fraunces",
      "ui": "Manrope",
      "mono": "JetBrains Mono"
    },
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18,
      "xl": 22,
      "2xl": 28,
      "3xl": 36,
      "4xl": 48,
      "hero": 64
    },
    "fontVariantNumeric": "tabular-nums"
  },
  "radius": { "card": 20, "sheet": 28, "pill": 9999 },
  "motion": {
    "spring": { "damping": 18, "stiffness": 180 },
    "auroraLoopSeconds": 60,
    "orbitRevolutionSeconds": 240,
    "reducedMotion": { "freezeAurora": true, "disableOrbitRotation": true }
  },
  "contrastPairs": [
    { "foreground": "ink.primary", "background": "bg.canvas" },
    { "foreground": "ink.primary", "background": "bg.raised" },
    { "foreground": "ink.primary", "background": "bg.sunken" },
    { "foreground": "ink.secondary", "background": "bg.canvas" },
    { "foreground": "ink.secondary", "background": "bg.raised" },
    { "foreground": "ink.secondary", "background": "bg.sunken" }
  ]
}
