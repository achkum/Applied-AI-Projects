{
  "name": "@subtrack/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./subscription-lifecycle": {
      "types": "./dist/detection/subscription-lifecycle.d.ts",
      "import": "./dist/detection/subscription-lifecycle.js",
      "require": "./dist/detection/subscription-lifecycle.js"
    },
    "./policy": {
      "types": "./policy/index.ts",
      "import": "./policy/index.ts"
    },
    "./bank": {
      "types": "./bank/index.ts",
      "import": "./bank/index.ts"
    },
    "./ingestion": {
      "types": "./ingestion/index.ts",
      "import": "./ingestion/index.ts"
    },
    "./merchant": {
      "types": "./merchant/index.ts",
      "import": "./merchant/index.ts"
    },
    "./detection": {
      "types": "./detection/index.ts",
      "import": "./detection/index.ts"
    },
    "./clustering": {
      "types": "./clustering/index.ts",
      "import": "./clustering/index.ts"
    },
    "./bank-runtime": {
      "types": "./dist/bank/index.d.ts",
      "import": "./dist/bank/index.js",
      "require": "./dist/bank/index.js"
    },
    "./ingestion-runtime": {
      "types": "./dist/ingestion/index.d.ts",
      "import": "./dist/ingestion/index.js",
      "require": "./dist/ingestion/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:lifecycle": "tsc -p tsconfig.lifecycle.json",
    "lint": "eslint \"policy/**/*.ts\" \"bank/**/*.ts\" \"ingestion/**/*.ts\" \"merchant/**/*.ts\" \"detection/**/*.ts\" \"clustering/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:bank": "tsc -p tsconfig.bank-runtime.json"
  },
  "dependencies": {
    "@subtrack/money": "workspace:*"
  },
  "devDependencies": {
    "@subtrack/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  }
}
