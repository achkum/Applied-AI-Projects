{
  "name": "@subtrack/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./policy": {
      "types": "./policy/index.ts",
      "import": "./policy/index.ts"
    },
    "./bank": {
      "types": "./bank/index.ts",
      "import": "./bank/index.ts"
    },
    "./ingestion": {
      "types": "./ingestion/index.ts",
      "import": "./ingestion/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"policy/**/*.ts\" \"bank/**/*.ts\" \"ingestion/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@subtrack/config": "workspace:*",
    "@subtrack/synthetic": "workspace:*",
    "vitest": "4.1.11"
  }
}
