{
  "name": "@subtrack/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./generated/index.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm generate",
    "contract:validate": "redocly lint openapi.yaml --extends=spec",
    "generate": "openapi-ts -f ./openapi-ts.config.mjs --no-log-file",
    "lint": "pnpm contract:validate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test ./tests/*.test.mjs && pnpm test:zod-fixture",
    "generate:fixture": "openapi-ts -f ./openapi-ts.fixture.config.mjs --no-log-file",
    "test:zod-fixture": "pnpm generate:fixture && node --experimental-strip-types --input-type=module -e \"import { zProbeOnly } from './fixtures/generated/zod.gen.ts'; if (!zProbeOnly.safeParse({ probeId: 'fixture' }).success) process.exit(1);\""
  },
  "devDependencies": {
    "@redocly/cli": "2.54.3",
    "@subtrack/config": "workspace:*",
    "zod": "4.6.5",
    "@hey-api/openapi-ts": "0.99.0"
  }
}
