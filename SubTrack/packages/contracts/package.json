{
  "name": "@subtrack/contracts",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm generate",
    "contract:validate": "redocly lint openapi.yaml --extends=spec",
    "generate": "orval --config ./orval.config.ts",
    "lint": "pnpm contract:validate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"console.log('contracts: no behavioral tests; OpenAPI validation is contract:validate')\""
  },
  "devDependencies": {
    "@redocly/cli": "2.54.3",
    "@subtrack/config": "workspace:*",
    "orval": "8.38.0",
    "zod": "4.6.5"
  }
}
