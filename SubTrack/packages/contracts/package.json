{
  "name": "@subtrack/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./generated/index.ts",
    "./identifiers": "./identifiers.ts",
    "./profile": "./profile.ts",
    "./private-onboarding": "./private-onboarding.ts",
    "./private-mobile": "./private-mobile.ts",
    "./private-mobile-bank": "./private-mobile-bank.ts",
    "./private-mobile-detection": "./private-mobile-detection.ts",
    "./sandbox-mobile": "./sandbox-mobile.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm generate",
    "contract:validate": "redocly lint openapi.yaml --extends=spec",
    "generate": "openapi-ts -f ./openapi-ts.config.mjs --no-log-file",
    "lint": "pnpm contract:validate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 ./tests/*.test.mjs && pnpm test:zod-fixture",
    "generate:fixture": "openapi-ts -f ./openapi-ts.fixture.config.mjs --no-log-file",
    "test:zod-fixture": "pnpm generate:fixture && node --experimental-strip-types --input-type=module -e \"import { zProbeOnly } from './fixtures/generated/zod.gen.ts'; if (!zProbeOnly.safeParse({ probeId: 'fixture' }).success) process.exit(1);\"",
    "test:private-mobile-bank": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=private-mobile-bank.ts --test-coverage-branches=100 --test-coverage-lines=100 --test-coverage-functions=100 tests/private-mobile-bank.test.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@redocly/cli": "2.54.3",
    "@subtrack/config": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0"
  }
}
