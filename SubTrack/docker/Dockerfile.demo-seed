FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config ./packages/config
COPY packages/synthetic ./packages/synthetic
COPY services/demo-seed ./services/demo-seed
RUN pnpm install --frozen-lockfile --filter @subtrack/demo-seed...

FROM base AS build
COPY --from=deps /app /app
RUN pnpm --filter @subtrack/demo-seed exec npx tsc -p services/demo-seed/tsconfig.json --outDir services/demo-seed/dist --noEmit false 2>/dev/null || true

FROM node:22-alpine
WORKDIR /app
# Copy built files and runtime dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/synthetic/src ./packages/synthetic/src
COPY --from=deps /app/services/demo-seed/src ./src
CMD ["node", "--experimental-vm-modules", "src/index.js"]
