# Development-only browser nonce endpoint (requires AUTH_V2_ENABLED=true).
AUTH_V2_BROWSER_NONCE_ENABLED=false
# Set distinct random 32-byte values locally (exactly 64 hexadecimal characters).
AUTH_V2_IDEMPOTENCY_KEY=
AUTH_V2_BROWSER_ORIGIN_HMAC_KEY=
# Development-only web OTP bridge. Keep disabled outside local development.
AUTH_V2_OTP_HTTP_ENABLED=false
# Use distinct random 32-byte values locally (exactly 64 hexadecimal characters).
AUTH_V2_OTP_HMAC_KEY=
AUTH_V2_RATE_LIMIT_HMAC_KEY=
